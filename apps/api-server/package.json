{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run start",
    "build": "node ./build.mjs",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "test:readiness": "node ./test-readiness.mjs && node --env-file-if-exists=../../.env --enable-source-maps ./dist/tests/readiness.test.mjs",
    "test:lifecycle": "node ./test-lifecycle.mjs && node --env-file-if-exists=../../.env --enable-source-maps ./dist/tests/lifecycle.test.mjs",
    "test:return": "node ./test-return.mjs && node --env-file-if-exists=../../.env --enable-source-maps ./dist/tests/return.test.mjs",
    "test:tracking": "node ./test-tracking.mjs && node --env-file-if-exists=../../.env --enable-source-maps ./dist/tests/tracking.test.mjs",
    "test:manual-order": "node ./test-manual-order.mjs && node --env-file-if-exists=../../.env --enable-source-maps ./dist/tests/manual-order.test.mjs",
    "typecheck": "tsc --build tsconfig.json --force"
  },
  "dependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express-session": "^1.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
}
